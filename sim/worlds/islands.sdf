<?xml version="1.0"?>
<!--
  Two small islands with open sea between them, for flights out of GNSS range over water.
  Gazebo uses ENU: +X east, +Y north, +Z up.
  The origin is the helipad on island A, where the drone starts. Island B and its helipad lie about
  490 m to the east, across roughly 230 m of open sea. The sea surface is 4 m below the helipads (z = -4).
  The scenery is generated by sim/scripts/make_islands.py (the launch file does it if missing).
-->
<sdf version="1.10">
  <world name="islands">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

    <!-- Open water in the Taiwan Strait, between Penghu and Taiwan. Elevation: helipad A above the sea. -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>23.6500</latitude_deg>
      <longitude_deg>119.8500</longitude_deg>
      <elevation>4</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.62 0.78 0.92 1</background>
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.25 0.25 0.22 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <!-- Islands, sea, trees, houses, lighthouse and helipads, generated by sim/scripts/make_islands.py -->
    <include>
      <uri>model://islands</uri>
    </include>
  </world>
</sdf>
