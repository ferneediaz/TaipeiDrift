<?xml version="1.0"?>
<!-- Compact urban visual-navigation world. World/body coordinates are ENU. -->
<sdf version="1.10">
  <world name="city">
    <physics name="1ms" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <spherical_coordinates><surface_model>EARTH_WGS84</surface_model><world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>25.0330</latitude_deg><longitude_deg>121.5654</longitude_deg><elevation>10</elevation><heading_deg>0</heading_deg></spherical_coordinates>
    <scene><ambient>0.62 0.62 0.62 1</ambient><background>0.62 0.72 0.82 1</background><shadows>false</shadows></scene>
    <light type="directional" name="sun"><cast_shadows>false</cast_shadows><pose>0 0 150 0 0 0</pose>
      <diffuse>0.95 0.94 0.88 1</diffuse><specular>0.15 0.15 0.15 1</specular><direction>-0.4 0.2 -0.9</direction></light>
    <include><uri>model://city</uri></include>
  </world>
</sdf>
